          "endMs": 212865
        }
      ]
    },
    {
      "startMs": 212865,
      "endMs": 216000,
      "words": [
        {
          "word": "AI 填错、漏填，",
          "startMs": 212865,
          "endMs": 213787
        },
        {
          "word": "当场报红，想乱发挥都没空间",
