          "endMs": 216000
        }
      ]
    },
    {
      "startMs": 216000,
      "endMs": 221682,
      "words": [
        {
          "word": "至于在现成组件上再扩一套自有品牌风格，",
          "startMs": 216000,
          "endMs": 220091
        },
        {
          "word": "那是更大的话题",
